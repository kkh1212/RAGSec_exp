{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "One explicitly copied observer import JSONL row",
  "type": "object",
  "required": ["sample_id", "query_id", "query", "response", "execution_status"],
  "properties": {
    "sample_id": {"type": "string", "minLength": 1},
    "query_id": {"type": "string", "minLength": 1},
    "query": {"type": "string", "minLength": 1},
    "response": {"type": "string"},
    "execution_status": {"enum": ["OK", "PROVIDER_BLOCK", "RATE_LIMIT", "AUTH_ERROR", "TIMEOUT", "INPUT_TOO_LONG", "INCOMPLETE", "OTHER_API_ERROR", "API_ERROR", "EMPTY_RESPONSE", "OUTPUT_TRUNCATED", "REPLAY_MISS", "CONFIG_MISMATCH"]},
    "label": {"enum": ["", "ANSWER", "REFUSAL", "OTHER", "UNCERTAIN"]},
    "label_status": {"enum": ["unreviewed", "suggested", "human_verified"]},
    "split": {"enum": ["", "train", "validation", "test"]},
    "data_kind": {"enum": ["real", "synthetic", "replay"]},
    "purpose": {"enum": ["observer_development", "final_defense_evaluation"]}
  },
  "additionalProperties": true,
  "$comment": "Extra import fields go to a metadata sidecar. Review/training rows accept only the ten canonical fields. Import resets all labels to suggested or unreviewed."
}
